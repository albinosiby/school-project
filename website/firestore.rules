rules_version = '2';
// Role-based rules, see docs/DATA_CONTRACT.md section 7.
// users/{authUid} = {schoolId, role: "admin"|"teacher"|"parent"|"driver"|"attendant", staffId?, crewId?, studentIds?, classIds?, grns?, ...}
// maps a login to its school. Parents (section 13) read only their own children's docs and the par_* projections the functions
// write. Bus crew (section 14, roles driver / attendant) read their own bus, its students and trips, and write their bus's
// trips / attendance, their own check-in days and leave requests.
// Everything under schools/{schoolId}/** is reachable only by users whose users doc points at that school.
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- helpers ----------
    function signedIn() { return request.auth != null; }
    function userPath(uid) { return /databases/$(database)/documents/users/$(uid); }
    function hasUser() { return signedIn() && exists(userPath(request.auth.uid)); }
    function me() { return get(userPath(request.auth.uid)).data; }
    function inSchool(sid) { return hasUser() && me().schoolId == sid; }
    function isAdmin(sid) { return inSchool(sid) && me().role == 'admin'; }
    function isTeacher(sid) { return inSchool(sid) && me().role == 'teacher' && me().get('staffId', '') != ''; }
    function myStaffId() { return me().staffId; }
    // parent: users/{uid}.studentIds / classIds / grns are kept by the onStudentWritten function (contract 13.1)
    function isParentIn(sid) { return inSchool(sid) && me().role == 'parent'; }
    function myStudents() { return me().get('studentIds', []); }
    function myClasses() { return me().get('classIds', []); }
    function myGrns() { return me().get('grns', []); }
    function isParent(sid, studentId) { return isParentIn(sid) && studentId in myStudents(); }
    function studentDoc(sid, studentId) { return get(/databases/$(database)/documents/schools/$(sid)/students/$(studentId)).data; }
    // a message thread as it is after this write: the existing thread for a plain write, or the one created in the same batch
    function threadAfter(sid, threadId) { return getAfter(/databases/$(database)/documents/schools/$(sid)/msg_threads/$(threadId)).data; }

    // teacher owns the existing doc / the doc being written (teacherId field)
    function ownsExisting() { return resource.data.get('teacherId', '') == myStaffId(); }
    function ownsIncoming() { return request.resource.data.get('teacherId', '') == myStaffId(); }
    // staff_attendance / staff_regularizations written by a teacher carry their own staffId (and teacherId)
    function ownRequest() {
      return request.resource.data.get('staffId', '') == myStaffId() && request.resource.data.get('teacherId', myStaffId()) == myStaffId();
    }
    function ownDay(docId) { return ownRequest() && docId == request.resource.data.get('date', '') + '_' + myStaffId(); }
    function onlyKeys(keys) { return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys); }
    // marks can be written only while the admin has not locked the paper (Exams > Lock Marks Entry)
    function paperOpen(sid) {
      return get(/databases/$(database)/documents/schools/$(sid)/exm_papers/$(request.resource.data.get('paperId', 'none'))).data.get('locked', false) != true;
    }

    // a parent's leave request: own child, own uid, the child's current class
    function parentLeaveOk(sid) {
      return isParent(sid, request.resource.data.get('studentId', ''))
        && request.resource.data.get('parentUid', '') == request.auth.uid
        && request.resource.data.get('classId', '') == studentDoc(sid, request.resource.data.studentId).get('classId', '');
    }
    // a parent's booking of ptm_slots/{slotId} (contract 13.7): own child and class, a future slot, the slot's own details
    function slotDoc(sid, slotId) { return get(/databases/$(database)/documents/schools/$(sid)/ptm_slots/$(slotId)).data; }
    function parentBookingOk(sid, slotId) {
      let d = request.resource.data;
      let slot = slotDoc(sid, slotId);
      return exists(/databases/$(database)/documents/schools/$(sid)/ptm_slots/$(slotId))
        && isParent(sid, d.get('studentId', ''))
        && d.get('parentUid', '') == request.auth.uid
        && d.get('classId', '') == studentDoc(sid, d.studentId).get('classId', '')
        && d.get('slotId', '') == slotId
        && d.get('status', '') == 'Scheduled'
        && d.get('teacherId', '') == slot.teacherId && d.get('startMs', 0) == slot.startMs && d.get('start', '') == slot.start
        && d.get('mins', 0) == slot.mins && d.get('room', '') == slot.get('room', '') && d.get('link', '') == slot.get('link', '')
        && d.get('mode', '') in slot.get('modes', [])
        && slot.startMs > request.time.toMillis()
        && !d.keys().hasAny(['minutes', 'joinedAt', 'cancelledBy', 'cancelReason', 'cancelledAt']);
    }
    // a parent's certificate request (contract 13.7): own child and class, own uid, no issue fields
    function parentCertificateOk(sid) {
      let d = request.resource.data;
      return isParent(sid, d.get('studentId', ''))
        && d.get('parentUid', '') == request.auth.uid
        && d.get('classId', '') == studentDoc(sid, d.studentId).get('classId', '')
        && d.get('status', '') == 'Requested'
        && d.get('type', '') in ['bonafide', 'character', 'transfer', 'feeReceipt', 'other']
        && !d.keys().hasAny(['refNo', 'issuedOn', 'validTill', 'issuer', 'fileUrl', 'note', 'rejectReason', 'downloadedAt']);
    }
    // a payment the parent made to the school account and reports for verification (contract 13.8)
    function parentClaimOk(sid) {
      let d = request.resource.data;
      return isParent(sid, d.get('studentId', ''))
        && d.get('grn', '') == studentDoc(sid, d.studentId).get('grn', '')
        && d.get('parentUid', '') == request.auth.uid
        && d.get('status', '') == 'Pending'
        && d.get('amount', 0) is number && d.amount > 0
        && d.get('reference', '') is string && d.reference.size() >= 4
        && !d.keys().hasAny(['receiptNo', 'paymentId', 'verifiedBy', 'verifiedAt', 'rejectReason']);
    }
    // a parent opens thr_{studentId}_{staffId} for their own child, listing themselves (and only that child's guardians)
    function parentThreadOk(sid, docId) {
      return isParent(sid, request.resource.data.get('studentId', ''))
        && request.auth.uid in request.resource.data.get('parentUids', [])
        && studentDoc(sid, request.resource.data.studentId).get('guardianUids', []).hasAll(request.resource.data.parentUids)
        && request.resource.data.get('classId', '') == studentDoc(sid, request.resource.data.studentId).get('classId', '')
        && docId == 'thr_' + request.resource.data.studentId + '_' + request.resource.data.get('teacherId', '');
    }
    // last* and the unread counters belong to the onMessageCreated function: a new thread starts empty
    // (lastMessage "" and both counters 0; lastAt / lastFrom may be set for sorting)
    function newThreadOk() {
      return request.resource.data.get('lastMessage', '') == ''
        && request.resource.data.get('lastFrom', 'parent') in ['parent', 'teacher']
        && request.resource.data.get('unreadParent', 0) == 0 && request.resource.data.get('unreadTeacher', 0) == 0;
    }
    // a message carries its thread's student, teacher and guardians (so both sides can query it)
    function messageMatchesThread(sid) {
      return request.resource.data.get('studentId', '') == threadAfter(sid, request.resource.data.threadId).get('studentId', 'none')
        && request.resource.data.get('teacherId', '') == threadAfter(sid, request.resource.data.threadId).get('teacherId', 'none')
        && request.resource.data.get('parentUids', []) == threadAfter(sid, request.resource.data.threadId).get('parentUids', [])
        && !request.resource.data.keys().hasAny(['counted']);
    }

    // ---------- transport crew (contract 14): driver / attendant of one bus ----------
    function isCrew(sid) { return inSchool(sid) && me().role in ['driver', 'attendant'] && me().get('crewId', '') != ''; }
    function myCrewId() { return me().crewId; }
    // the crew member's bus comes from tr_crew/{crewId}.busId (kept by the admin web), never from the client
    function myBusId(sid) { return get(/databases/$(database)/documents/schools/$(sid)/tr_crew/$(myCrewId())).data.get('busId', ''); }
    function onMyBus(sid) { return myBusId(sid) != '' && resource.data.get('busId', '') == myBusId(sid); }
    // tr_trips / tr_attendance of the crew member's bus: id {date}_{busId}_{pickup|drop} built from the incoming doc
    function myBusRecordOk(sid, docId) {
      let d = request.resource.data;
      return myBusId(sid) != '' && d.get('busId', '') == myBusId(sid)
        && d.get('kind', '') in ['pickup', 'drop']
        && d.get('date', '') is string && d.date.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}')
        && docId == d.date + '_' + d.busId + '_' + d.kind;
    }
    // bus, date and direction of an existing trip / attendance record never change
    function busRecordKeysFixed() {
      return request.resource.data.get('busId', '') == resource.data.get('busId', '')
        && request.resource.data.get('date', '') == resource.data.get('date', '')
        && request.resource.data.get('kind', '') == resource.data.get('kind', '');
    }
    // own check-in day: tr_crew_attendance/{date}_{crewId} carrying crewId
    function myCrewDayOk(docId) {
      return request.resource.data.get('crewId', '') == myCrewId() && docId == request.resource.data.get('date', '') + '_' + myCrewId();
    }
    // own leave request, pending, without the admin's decision fields
    function myCrewLeaveOk() {
      let d = request.resource.data;
      return d.get('crewId', '') == myCrewId() && d.get('status', '') == 'Pending'
        && !d.keys().hasAny(['decidedBy', 'decidedAt', 'decisionNote']);
    }

    // ---------- users ----------
    match /users/{uid} {
      // a user reads their own doc; an admin reads the docs of their school (to see staff accounts)
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin(resource.data.schoolId));
      // Admin sign-up (and first login of a pre-existing school): a user may create ONLY their own admin doc for the
      // school whose id is their own uid. That grants nothing beyond their own namespace schools/{uid}.
      allow create: if signedIn() && (
        (request.auth.uid == uid && request.resource.data.schoolId == uid && request.resource.data.role == 'admin')
        || isAdmin(request.resource.data.schoolId));
      allow update: if isAdmin(resource.data.schoolId) && request.resource.data.schoolId == resource.data.schoolId;
      allow delete: if isAdmin(resource.data.schoolId);

      // push notification device tokens (one doc per token); the Cloud Functions read them with admin access
      match /fcm_tokens/{token} {
        allow read, write: if signedIn() && request.auth.uid == uid;
      }
    }

    match /schools/{sid} {

      // ---------- generic docs: schools/{sid}/{collection}/{docId} ----------
      match /{col}/{docId} {
        // admin: everything in the school
        allow read, write: if isAdmin(sid);

        // parent: only their own children's data (contract 13.2)
        allow read: if isParentIn(sid) && (
          (col == 'students' && docId in myStudents())
          || (col == 'classes' && docId in myClasses())
          || col == 'school'
          || (col in ['ops_periods', 'live_classes'] && resource.data.get('classId', '') in myClasses())
          || (col in ['par_attendance', 'par_homework', 'par_results', 'student_leaves', 'ptm_bookings', 'certificates', 'fee_claims']
              && resource.data.get('studentId', '') in myStudents())
          // meeting slots carry no student data (contract 13.7)
          || col == 'ptm_slots'
          // a month of attendance by id ({studentId}_{YYYY-MM}), also before the function has written it
          || (col == 'par_attendance' && docId.matches('.+_[0-9]{4}-[0-9]{2}') && docId[0:docId.size() - 8] in myStudents())
          || (col in ['fee_invoices', 'fee_payments'] && resource.data.get('grn', '') in myGrns())
          || (col in ['com_notices', 'calendar_events'] && resource.data.get('parentVisible', false) == true)
          || (col in ['msg_threads', 'msg_messages'] && request.auth.uid in resource.data.get('parentUids', []))
          || (col == 'par_notifications' && resource.data.get('uid', '') == request.auth.uid)
          || (col == 'consents' && docId == request.auth.uid));

        // parent: own requests (leave, messages, consent); par_notifications only `read`
        allow create: if isParentIn(sid) && (
          (col == 'student_leaves' && parentLeaveOk(sid) && request.resource.data.get('status', '') == 'Pending')
          || (col == 'msg_threads' && parentThreadOk(sid, docId) && newThreadOk())
          || (col == 'msg_messages' && request.resource.data.get('from', '') == 'parent' && request.resource.data.get('uid', '') == request.auth.uid
              && request.auth.uid in threadAfter(sid, request.resource.data.get('threadId', 'none')).get('parentUids', []) && messageMatchesThread(sid))
          || (col == 'consents' && docId == request.auth.uid && request.resource.data.get('uid', '') == request.auth.uid)
          || (col == 'ptm_bookings' && parentBookingOk(sid, docId))
          || (col == 'certificates' && parentCertificateOk(sid))
          || (col == 'fee_claims' && parentClaimOk(sid)));
        allow update: if isParentIn(sid) && (
          // meetings: re-book a cancelled slot, cancel a scheduled meeting of own child, record the join tap
          (col == 'ptm_bookings' && resource.data.get('status', '') == 'Cancelled' && parentBookingOk(sid, docId))
          || (col == 'ptm_bookings' && isParent(sid, resource.data.get('studentId', '')) && resource.data.get('status', '') == 'Scheduled'
              && onlyKeys(['status', 'cancelledBy', 'cancelledAt', 'updatedAt', 'updatedBy'])
              && request.resource.data.status == 'Cancelled' && request.resource.data.get('cancelledBy', '') == 'parent')
          || (col == 'ptm_bookings' && isParent(sid, resource.data.get('studentId', '')) && onlyKeys(['joinedAt', 'updatedAt', 'updatedBy']))
          // certificates: note the download of an issued one
          || (col == 'certificates' && isParent(sid, resource.data.get('studentId', '')) && resource.data.get('status', '') == 'Issued'
              && onlyKeys(['downloadedAt', 'updatedAt', 'updatedBy']))
          // edit own leave only while pending; cannot decide it or move it to another child
          || (col == 'student_leaves' && resource.data.get('parentUid', '') == request.auth.uid && resource.data.get('status', '') == 'Pending'
              && parentLeaveOk(sid) && request.resource.data.get('status', '') == 'Pending' && request.resource.data.studentId == resource.data.studentId)
          // reading a thread resets the parent's own unread counter, nothing else
          || (col == 'msg_threads' && request.auth.uid in resource.data.get('parentUids', [])
              && onlyKeys(['unreadParent', 'updatedAt', 'updatedBy']) && request.resource.data.get('unreadParent', 0) == 0)
          || (col == 'consents' && docId == request.auth.uid && request.resource.data.get('uid', '') == request.auth.uid)
          || (col == 'par_notifications' && resource.data.get('uid', '') == request.auth.uid && onlyKeys(['read'])));
        allow delete: if isParentIn(sid) && (
          (col == 'student_leaves' && resource.data.get('parentUid', '') == request.auth.uid && resource.data.get('status', '') == 'Pending')
          // withdraw a reported payment before the office checks it
          || (col == 'fee_claims' && resource.data.get('parentUid', '') == request.auth.uid && resource.data.get('status', '') == 'Pending')
          // withdraw a certificate request before the office handles it
          || (col == 'certificates' && isParent(sid, resource.data.get('studentId', '')) && resource.data.get('status', '') == 'Requested'));

        // teacher: read the master + shared collections (admin writes the master ones)
        allow read: if isTeacher(sid) && (
          col in ['school', 'staff', 'classes', 'assignments', 'students', 'ops_periods', 'ops_substitutions',
                  'exm_cycles', 'exm_papers', 'exm_candidates', 'com_notices', 'calendar_events',
                  'ops_attendance', 'ops_homework', 'exm_marks', 'live_classes', 'student_leaves',
                  'exm_duties', 'set_leave_policy']
          // own leave requests, check-in days and regularization requests only (contract section 12)
          || (col in ['staff_leaves', 'staff_attendance', 'staff_regularizations'] && resource.data.get('staffId', '') == myStaffId())
          // own check-in day by id, also when it does not exist yet (the app reads today's doc directly)
          || (col == 'staff_attendance' && docId.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}_' + myStaffId()))
          // own private data
          || (col.matches('(tt|tk|cl|ls|ts|hm|ms|pm|ed|cr|att|lm)_.*') && ownsExisting())
          // parent message threads addressed to this teacher (contract 13.3), own meeting slots and bookings (13.7)
          || (col in ['msg_threads', 'msg_messages', 'ptm_slots', 'ptm_bookings'] && ownsExisting()));

        // teacher: shared records, only for their own staffId
        allow create: if isTeacher(sid) && (
          (col in ['ops_attendance', 'ops_homework', 'exm_marks', 'live_classes'] && ownsIncoming() && (col != 'exm_marks' || paperOpen(sid)))
          || (col == 'staff_leaves' && request.resource.data.get('staffId', '') == myStaffId())
          // own check-in day: staff_attendance/{date}_{staffId}
          || (col == 'staff_attendance' && ownDay(docId))
          // a regularization request always starts pending
          || (col == 'staff_regularizations' && ownRequest() && request.resource.data.get('status', '') == 'Pending')
          // the mirrored row that puts a leave request into the admin approvals queue (always starts pending)
          || (col == 'approvals' && request.resource.data.get('kind', '') == 'leave' && request.resource.data.get('status', '') == 'pending')
          || (col.matches('(tt|tk|cl|ls|ts|hm|ms|pm|ed|cr|att|lm)_.*') && ownsIncoming())
          // parent messages: a thread with a child's guardians, and messages in the teacher's own threads
          || (col == 'msg_threads' && ownsIncoming() && docId == 'thr_' + request.resource.data.get('studentId', '') + '_' + myStaffId()
              && studentDoc(sid, request.resource.data.studentId).get('guardianUids', []).hasAll(request.resource.data.get('parentUids', [])) && newThreadOk())
          || (col == 'msg_messages' && ownsIncoming() && request.resource.data.get('from', '') == 'teacher' && request.resource.data.get('uid', '') == request.auth.uid
              && threadAfter(sid, request.resource.data.get('threadId', 'none')).get('teacherId', '') == myStaffId() && messageMatchesThread(sid)));
        allow update: if isTeacher(sid) && (
          (col in ['ops_attendance', 'ops_homework', 'exm_marks', 'live_classes'] && ownsExisting() && ownsIncoming() && (col != 'exm_marks' || paperOpen(sid)))
          // a leave can be edited or withdrawn only while pending, and cannot be decided by its owner
          || (col == 'staff_leaves' && resource.data.get('staffId', '') == myStaffId() && resource.data.status == 'Pending'
              && request.resource.data.get('staffId', '') == myStaffId() && request.resource.data.status == 'Pending')
          || (col == 'staff_attendance' && resource.data.get('staffId', '') == myStaffId() && ownDay(docId))
          // a regularization can be edited only while pending, and cannot be decided by its owner
          || (col == 'staff_regularizations' && resource.data.get('staffId', '') == myStaffId() && resource.data.get('status', '') == 'Pending'
              && ownRequest() && request.resource.data.get('status', '') == 'Pending')
          // the substitute accepts or declines their own assignment
          || (col == 'ops_substitutions' && resource.data.get('substituteTeacherId', '') == myStaffId()
              && onlyKeys(['status', 'updatedAt', 'updatedBy']) && request.resource.data.status in ['Accepted', 'Declined'])
          // teachers decide student leave requests (status + note only; what the parent asked for stays untouched)
          || (col == 'student_leaves' && onlyKeys(['status', 'decisionNote', 'decidedBy', 'decidedAt', 'updatedAt', 'updatedBy'])
              && request.resource.data.get('status', '') in ['Pending', 'Approved', 'Rejected'])
          // reading a thread resets the teacher's own unread counter, nothing else
          || (col == 'msg_threads' && ownsExisting() && onlyKeys(['unreadTeacher', 'updatedAt', 'updatedBy']) && request.resource.data.get('unreadTeacher', 0) == 0)
          || (col.matches('(tt|tk|cl|ls|ts|hm|ms|pm|ed|cr|att|lm)_.*') && ownsExisting() && ownsIncoming()));
        // hard delete is admin-only for shared records; teachers may delete their own private docs
        allow delete: if isTeacher(sid) && (
          (col in ['staff_leaves', 'staff_regularizations'] && resource.data.get('staffId', '') == myStaffId() && resource.data.get('status', '') == 'Pending')
          || (col.matches('(tt|tk|cl|ls|ts|hm|ms|pm|ed|cr|att|lm)_.*') && ownsExisting()));

        // bus crew (driver / attendant, contract 14.7): own bus only
        allow read: if isCrew(sid) && (
          // the school, every crew member (the partner card) and the transport settings
          col in ['school', 'tr_crew', 'tr_settings']
          || (col == 'tr_buses' && myBusId(sid) != '' && docId == myBusId(sid))
          // the roster: students on the crew member's bus
          || (col == 'students' && onMyBus(sid))
          // the bus's trips and attendance records, also by id before the day's docs exist
          || (col in ['tr_trips', 'tr_attendance'] && onMyBus(sid))
          || (col in ['tr_trips', 'tr_attendance'] && myBusId(sid) != '' && docId.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}_' + myBusId(sid) + '_(pickup|drop)'))
          // own check-in days (also by id before today's doc exists) and own leave requests
          || (col == 'tr_crew_attendance' && resource.data.get('crewId', '') == myCrewId())
          || (col == 'tr_crew_attendance' && docId.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}_' + myCrewId()))
          || (col == 'tr_crew_leaves' && resource.data.get('crewId', '') == myCrewId())
          || (col == 'com_notices' && resource.data.get('status', '') == 'Published'));
        allow create: if isCrew(sid) && (
          (col in ['tr_trips', 'tr_attendance'] && myBusRecordOk(sid, docId))
          || (col == 'tr_crew_attendance' && myCrewDayOk(docId))
          || (col == 'tr_crew_leaves' && myCrewLeaveOk()));
        allow update: if isCrew(sid) && (
          (col in ['tr_trips', 'tr_attendance'] && onMyBus(sid) && myBusRecordOk(sid, docId) && busRecordKeysFixed())
          || (col == 'tr_crew_attendance' && resource.data.get('crewId', '') == myCrewId() && myCrewDayOk(docId))
          // a leave can be edited or withdrawn only while pending, and cannot be decided by its owner
          || (col == 'tr_crew_leaves' && resource.data.get('crewId', '') == myCrewId() && resource.data.get('status', '') == 'Pending' && myCrewLeaveOk())
          // own profile: contact details and photo only (bus, role, status and licence belong to the admin)
          || (col == 'tr_crew' && docId == myCrewId()
              && onlyKeys(['phone', 'address', 'emergencyName', 'emergencyPhone', 'photoUrl', 'updatedAt', 'updatedBy'])));
        allow delete: if isCrew(sid)
          && col == 'tr_crew_leaves' && resource.data.get('crewId', '') == myCrewId() && resource.data.get('status', '') == 'Pending';
      }

      // ---------- live class join taps: live_classes/{id}/joins/{authUid} ----------
      match /live_classes/{lid}/joins/{joinUid} {
        allow read: if isAdmin(sid) || isTeacher(sid);
        // any member of the school records their own tap (parents join from the parent app)
        allow create, update: if inSchool(sid) && request.auth.uid == joinUid;
        allow delete: if isAdmin(sid);
      }

      // ---------- notice acknowledgements: com_notices/{id}/acks/{authUid} (contract 13.3) ----------
      match /com_notices/{nid}/acks/{ackUid} {
        // admin reads all (generic rule below); a user reads their own ack
        allow read: if inSchool(sid) && request.auth.uid == ackUid;
        // parents acknowledge notices they can see; the function counts them
        allow create: if isParentIn(sid) && request.auth.uid == ackUid
          && get(/databases/$(database)/documents/schools/$(sid)/com_notices/$(nid)).data.get('parentVisible', false) == true;
      }

      // ---------- other nested subcollections: admin only ----------
      match /{col}/{docId}/{sub=**} {
        allow read, write: if isAdmin(sid);
      }
    }

    // everything else is closed
    match /{document=**} { allow read, write: if false; }
  }
}
