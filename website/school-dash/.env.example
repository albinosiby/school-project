# Copy to .env.local in each app — values come from `firebase apps:sdkconfig WEB <appId>`.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Optional local Firebase suite. `npm run dev:emulator` enables these explicitly.
# A normal dev server uses the configured cloud project even on localhost.
# NEXT_PUBLIC_EMULATOR=true
# NEXT_PUBLIC_EMULATOR_PROJECT=demo-school-e2e
# NEXT_PUBLIC_EMULATOR_HOST=localhost

# Cross-app URLs. Use public hosting/custom-domain URLs in production.
NEXT_PUBLIC_ADMIN_URL=http://localhost:3000
NEXT_PUBLIC_LANDING_URL=http://localhost:3001
NEXT_PUBLIC_OWNER_URL=http://localhost:3002
